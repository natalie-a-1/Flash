{
  "name": "flash",
  "version": "1.0.0",
  "description": "Flash blockchain project",
  "main": "index.js",
  "scripts": {
    "test": "truffle test",
    "test:fork": "truffle test --network development_fork",
    "test:fork:mainnet": "truffle test --network mainnet_fork",
    "compile": "truffle compile",
    "migrate": "truffle migrate",
    "migrate:sepolia": "truffle migrate --network sepolia",
    "dev": "truffle develop",
    "ganache": "ganache-cli",
    "ganache:mainnet": "ganache-cli --fork $NEXT_PUBLIC_MAINNET_RPC_URL",
    "ganache:mainnet:persistent": "ganache --fork $NEXT_PUBLIC_MAINNET_RPC_URL@${BLOCK_NUMBER:-latest} --unlock $USDC_WHALE_ADDRESS -a 10 -e 1000 --db ./ganache-db -d",
    "copy-contracts": "node copy-contracts.js",
    "postmigrate": "npm run copy-contracts",
    "format": "prettier --write .",
    "check:format": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@truffle/hdwallet-provider": "^2.1.15",
    "dotenv": "^16.3.1",
    "web3": "^1.10.0"
  },
  "devDependencies": {
    "@aave/core-v3": "^1.19.3",
    "@openzeppelin/contracts": "^5.3.0",
    "@openzeppelin/test-helpers": "^0.5.16",
    "ganache": "^7.9.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "prettier": "^3.0.0",
    "prettier-plugin-solidity": "^1.4.2",
    "truffle": "^5.11.5",
    "truffle-assertions": "^0.9.2"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,sol,json,css,scss,md,yml}": [
      "prettier --write"
    ]
  }
}
