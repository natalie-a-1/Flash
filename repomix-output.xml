    "methods": {
      "constructor": {
        "params": {
          "_addressesProvider": "The Aave Pool Addresses Provider address"
        }
      },
      "executeOperation(address,uint256,uint256,address,bytes)": {
        "details": "Executes the dynamic arbitrage strategy and handles repayment.      Reverts if the strategy fails or if repayment conditions are not met.",
        "params": {
          "_initiator": "The address that initiated the flash loan request",
          "amount": "The amount of the token borrowed.",
          "asset": "The address of the borrowed token",
          "params": "Encoded arbitrage parameters",
          "premium": "The fee charged by Aave for the flash loan."
        },
        "returns": {
          "_0": "bool Returns `true` if the operation and repayment approval were successful."
        }
      },
      "requestFlashLoan(address,uint256,address,address,address,uint256)": {
        "details": "Triggers the flash loan process; executeOperation will be called by Aave",
        "params": {
          "_amount": "The amount to borrow",
          "_asset": "The token to borrow",
          "_intermediateToken": "The token to use as intermediate for the arbitrage",
          "_slippageBps": "Slippage tolerance in basis points (1 BPS = 0.01%)",
          "_sourceRouter": "The router to use for the first swap",
          "_targetRouter": "The router to use for the second swap"
        }
      },
      "requestFlashLoanWithCustomPaths(address,uint256,address,address,address,address[],address[],uint256)": {
        "details": "Allows specifying custom paths for more complex arbitrage routes",
        "params": {
          "_amount": "The amount to borrow",
          "_asset": "The token to borrow",
          "_firstPath": "Custom path for first swap (must start with _asset and end with _intermediateToken)",
          "_intermediateToken": "The intermediate token",
          "_secondPath": "Custom path for second swap (must start with _intermediateToken and end with _asset)",
          "_slippageBps": "Slippage tolerance in basis points (1 BPS = 0.01%)",
          "_sourceRouter": "The router to use for the first swap",
          "_targetRouter": "The router to use for the second swap"
        }
      },
      "setRouterApproval(address,bool)": {
        "details": "Only callable by the owner",
        "params": {
          "_approved": "Whether to approve or disapprove the router",
          "_router": "The router address to approve or disapprove"
        }
      },
      "withdrawEther()": {
        "details": "Reverts if called by non-owner or if the transfer fails"
      },
      "withdrawToken(address)": {
        "details": "Can only be called by the owner",
        "params": {
          "_tokenAddress": "The address of the ERC20 token to withdraw"
        }
      }
    },
    "title": "Dynamic FlashLoan Arbitrage",
    "version": 1
  },
