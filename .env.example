# MetaMask/Wallet Configuration
# -------------------------
# Your wallet mnemonic (12/24 word seed phrase)
# IMPORTANT: Never commit your actual mnemonic to git!
MNEMONIC=word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12

# Sepolia Testnet Configuration
# ----------------------------
# You can get an API key from services like Alchemy (https://www.alchemy.com/) 
# or Infura (https://infura.io/)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# You can also use the public RPC endpoint, but it may be rate-limited
# SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Etherscan API Key (for contract verification)
# ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY 